// Sem veus de tela cheia. Os dois que existiam aqui (#0b0e14c0 a 88% e
// #00000055) quase apagavam a arte — e nem se notava, porque o fundo era um
// JPEG com extensao .png que o cliente nao carregava. O escurecimento que o
// login precisa agora vem embutido no proprio PNG (tools/gerar_tema.py).
Panel
  id: background
  image-source: /client_background/background
  image-smooth: true
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  focusable: false

  UILabel
    id: clientVersionLabel
    image-source: /images/ui/hegemony/window_headless
    image-border: 6
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    text-align: center
    text-auto-resize: true
    padding: 7 12 7 12
    margin-left: 14
    margin-bottom: 14
    color: #d6aa5c
    font: verdana-11px-monochrome
    !text: 'Hegemony'
