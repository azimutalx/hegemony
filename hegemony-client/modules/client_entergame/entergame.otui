// Tela de login do Hegemony. Os estilos Hegemony* abaixo usam as texturas de
// tools/gerar_tema.py; os campos no fim do arquivo continuam existindo com
// altura zero porque entergame.lua e client_serverlist ainda os consultam.
HegemonyLoginLabel < Label
  font: verdana-11px-antialised
  color: #c9b79c
  text-auto-resize: true

HegemonyField < UITextEdit
  font: verdana-11px-antialised
  color: #f3e6d8
  height: 26
  text-offset: 0 5
  padding: 4 8 4 8
  image-source: /images/ui/hegemony/textedit
  image-clip: 0 0 64 24
  image-border: 2
  selection-color: #ffffff
  selection-background-color: #8e3520
  change-cursor-image: false

  $focus:
    image-clip: 0 24 64 24

HegemonyPasswordField < HegemonyField
  text-hidden: true
  padding-right: 28

  UICheckBox
    size: 19 20
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: -24
    image-rect: 0 0 19 20
    image-source: /images/ui/hide_eye
    image-color: #d6aa5c
    !tooltip: tr('Mostrar senha')
    @onCheckChange: |
      self:getParent():setTextHidden(not self:isChecked())
      self:getParent():setTextWrap(false)

    $!checked:
      image-clip: 0 0 19 20

    $checked:
      image-clip: 0 20 19 20

HegemonyComboBox < UIComboBox
  font: verdana-11px-antialised
  color: #f3e6d8
  height: 26
  text-align: left
  text-offset: 10 1
  image-source: /images/ui/hegemony/combobox
  image-clip: 0 0 128 24
  image-border: 3
  image-border-right: 22

  $hover !disabled:
    image-clip: 0 24 128 24

  $on:
    image-clip: 0 48 128 24

HegemonyComboBoxPopupMenu < UIPopupMenu
  image-source: /images/ui/hegemony/window_headless
  image-border: 6
  padding: 3

HegemonyComboBoxPopupMenuButton < UIButton
  height: 24
  font: verdana-11px-antialised
  text-align: left
  text-offset: 8 0
  color: #c9b79c
  background-color: alpha

  $hover !disabled:
    color: #ffffff
    background-color: #8e352099

HegemonyCheckBox < UICheckBox
  size: 14 14
  font: verdana-11px-antialised
  text-align: left
  text-offset: 20 0
  color: #c9b79c
  image-rect: 0 0 14 14
  image-source: /images/ui/hegemony/checkbox

  $!checked:
    image-clip: 0 0 14 14

  $checked !disabled:
    image-clip: 0 14 14 14

  $checked disabled:
    image-clip: 0 28 14 14

HegemonyLink < UIButton
  font: verdana-11px-antialised
  color: #d6aa5c
  text-auto-resize: true

  $hover:
    color: #ffffff

// Mesma assinatura do upstream: toggleStayLoggedBox e setUniqueServer leem
// estes campos. Ancorada a direita, sobre a parte escurecida do fundo.
EnterGameWindow < Window
  !text: 'Hegemony'
  size: 300 348
  anchors.right: parent.right
  anchors.verticalCenter: parent.verticalCenter
  // Um pouco abaixo do centro para nao cobrir o fim do logotipo da arte.
  margin-top: 70
  margin-right: 90
  draggable: false
  padding-left: 22
  padding-right: 22

ServerListButton < UIButton
  size: 17 17
  image-source: /images/topbuttons/minimap
  image-color: #ffffffff

EnterGameWindow
  id: enterGame
  &authenticatorEnabled: false
  &authenticatorHeight: 44
  &stayLoggedBoxEnabled: false
  &stayLoggedBoxHeight: 24
  @onEnter: EnterGame.doLogin()

  HegemonyLoginLabel
    id: serverChoiceLabel
    !text: tr('Servidor')
    anchors.left: parent.left
    anchors.top: parent.top

  HegemonyComboBox
    id: serverComboBox
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: serverChoiceLabel.bottom
    margin-top: 5

  Label
    id: serverDescriptionLabel
    font: verdana-11px-antialised
    color: #8f7f6a
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: serverComboBox.bottom
    margin-top: 5
    text-auto-resize: true

  HorizontalSeparator
    id: loginSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: serverDescriptionLabel.bottom
    margin-top: 12

  HegemonyLoginLabel
    id: emailLabel
    !text: tr('Email')
    anchors.left: parent.left
    anchors.top: loginSeparator.bottom
    margin-top: 12

  HegemonyField
    id: accountNameTextEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: emailLabel.bottom
    margin-top: 5

  HegemonyLoginLabel
    id: passwordLabel
    !text: tr('Senha')
    anchors.left: parent.left
    anchors.top: accountNameTextEdit.bottom
    margin-top: 12

  HegemonyPasswordField
    id: accountPasswordTextEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: passwordLabel.bottom
    margin-top: 5

  HegemonyCheckBox
    id: rememberEmailBox
    !text: tr('Lembrar email e senha')
    !tooltip: tr('Guarda email e senha deste servidor no config.otml')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: accountPasswordTextEdit.bottom
    margin-top: 12
    @onCheckChange: |
      self:getParent():getChildById('autoLoginBox'):setEnabled(self:isChecked())

  Button
    id: loginButton
    !text: tr('Entrar')
    font: verdana-11px-antialised
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: rememberEmailBox.bottom
    margin-top: 16
    height: 32
    @onClick: EnterGame.doLogin()

  HegemonyLink
    id: createAccountLink
    !text: tr('Criar conta')
    anchors.left: parent.left
    anchors.top: loginButton.bottom
    margin-top: 12
    @onClick: EnterGame.openSite('?account/create')

  HegemonyLink
    id: Forgot_password_email
    !text: tr('Esqueci a senha')
    anchors.right: parent.right
    anchors.top: loginButton.bottom
    margin-top: 12
    @onClick: EnterGame.openSite('?account/lost')

  // --- Campos do upstream, escondidos -------------------------------------

  UIWidget
    id: rememberEmailTip
    visible: false
    height: 0

  QtCheckBox
    id: stayLoggedBox
    !text: tr('Stay logged during session')
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0

  MenuLabel
    id: serverLabel
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0

  ServerListButton
    id: serverListButton
    anchors.right: parent.right
    anchors.top: parent.bottom
    visible: false
    height: 0

  TextEdit
    id: serverHostTextEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.bottom
    visible: false
    height: 0

  MenuLabel
    id: versionLabel
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0

  UIWidget
    id: clientLabel
    anchors.top: parent.bottom
    visible: false
    height: 0

  ComboBox
    id: clientComboBox
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0

  UIWidget
    id: clientVersionTextEdit
    anchors.top: parent.bottom
    visible: false
    height: 0

  MenuLabel
    id: portLabel
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0

  TextEdit
    id: serverPortTextEdit
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0

  QtCheckBox
    id: autoLoginBox
    enabled: false
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0

  QtCheckBox
    id: httpLoginBox
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0

  QtButton
    id: btnCreateNewAccount
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0

  Label
    id: serverInfoLabel
    anchors.left: parent.left
    anchors.top: parent.bottom
    visible: false
    height: 0
