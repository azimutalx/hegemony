EnterGameWindow < MainWindow
  !text: 'Hegemony PvP - Login'
  size: 260 220
  background-color: #1e2325e6
  border: 1 #0984e377
  image-source: 


EnterGameButton < Button
  width: 64

ServerListButton < UIButton
  size: 17 17
  image-source: /images/topbuttons/minimap
  image-color: #ffffffff

  $hover !disabled:
    image-color: #ffffff99

  $pressed:
    image-color: #ffffff44

  $disabled:
    image-color: #ffffff55

EnterGameWindow
  id: enterGame
  &authenticatorEnabled: false
  &authenticatorHeight: 44
  &stayLoggedBoxEnabled: false
  &stayLoggedBoxHeight: 24
  size: 260 220
  background-color: #1e2325e6
  border: 1 #0984e377
  image-source: 
  @onEnter: EnterGame.doLogin()

  Label
    id: emailLabel
    !text: tr('Acc Name:') 
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 8
    color: #dfe6e9
    opacity: 0.9

  HiddenTextQtToggleEdit
    id: accountNameTextEdit
    anchors.right: parent.right
    anchors.left: emailLabel.right
    anchors.verticalCenter: emailLabel.verticalCenter
    margin-left: 10
    background-color: #0f141cd0
    border: 1 #0984e366
    color: #dfe6e9

  Label
    id: passwordLabel
    !text: tr('Password:')
    anchors.left: parent.left
    anchors.top: accountNameTextEdit.bottom
    margin-top: 14
    color: #dfe6e9
    opacity: 0.9

  HiddenTextQtEdit
    id: accountPasswordTextEdit
    anchors.right: parent.right
    anchors.left: passwordLabel.right
    anchors.verticalCenter: passwordLabel.verticalCenter
    margin-left: 10
    background-color: #0f141cd0
    border: 1 #0984e366
    color: #dfe6e9

  QtCheckBox
    id: rememberEmailBox
    !text: tr('Remember password')
    !tooltip: tr('Remember account and password when starts client')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: accountPasswordTextEdit.bottom
    margin-top: 12
    color: #dfe6e9
    opacity: 0.85
    @onCheckChange: |
      self:getParent():getChildById('autoLoginBox'):setEnabled(self:isChecked())
      self:getParent():getChildById('rememberEmailTip'):setOn(self:isChecked())

  UIWidget
    id: rememberEmailTip
    image-source: /images/icons/show_gui_help_grey
    !specialtooltip: 'Be aware that your email address will be stored on your configuration file "config.otml" if you activate this option.'
    anchors.right: accountNameTextEdit.right
    anchors.verticalCenter: rememberEmailBox.verticalCenter
    visible: false

    $on:
      visible: true

    $!on:
      visible: false

  UIButton
    !text: tr('Forgot password and/or email')
    id: Forgot_password_email
    font: verdana-11px-monochrome-underline
    color: #dfe6e9
    text-align: left
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: rememberEmailBox.bottom
    opacity: 0.75
    margin-top: 4
    @onClick: g_platform.openUrl('http://127.0.0.1/')

  QtButton
    id: loginButton
    !text: tr('Login')
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: Forgot_password_email.bottom
    margin-top: 12
    size: 130 24
    background-color: #0984e3cc
    border: 1 #0984e3ff
    color: #ffffff
    font: verdana-11px-monochrome
    $hover:
      background-color: #d63031cc
      border: 1 #d63031ff
    @onClick: EnterGame.doLogin()

  UIButton
    id: createAccountLink
    !text: tr('Criar Conta')
    font: verdana-11px-monochrome-underline
    color: #dfe6e9
    text-align: center
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: loginButton.bottom
    margin-top: 8
    opacity: 0.9
    $hover:
      color: #ffffff
      opacity: 1.0
    @onClick: g_platform.openUrl('http://127.0.0.1/')

  QtCheckBox
    id: stayLoggedBox
    !text: tr('Stay logged during session')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.bottom
    visible: false
    height: 0

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.bottom
    visible: false
    height: 0

  MenuLabel
    id: serverLabel
    !text: tr('Server')
    anchors.left: parent.left
    anchors.top: parent.bottom
    text-auto-resize: true
    visible: false
    height: 0

  ServerListButton
    id: serverListButton
    !tooltip: tr('Server list')
    anchors.right: parent.right
    anchors.top: parent.bottom
    @onClick: EnterGame.showServerList()
    visible: false
    height: 0

  TextEdit
    id: serverHostTextEdit
    !tooltip: tr('Make sure that your client uses\nthe correct game client version')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.bottom
    visible: false
    height: 0

  MenuLabel
    id: versionLabel
    !text: tr('Client Version')
    anchors.left: parent.left
    anchors.top: parent.bottom
    text-auto-resize: true
    visible: false
    height: 0

  UIWidget
    id: clientLabel
    anchors.top: parent.bottom
    visible: false
    height: 0

  ComboBox
    id: clientComboBox
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.top: parent.bottom
    width: 90
    visible: false
    height: 0

  UIWidget
    id: clientVersionTextEdit
    anchors.top: parent.bottom
    visible: false
    height: 0

  MenuLabel
    id: portLabel
    !text: tr('Port')
    anchors.left: parent.left
    anchors.top: parent.bottom
    text-auto-resize: true
    visible: false
    height: 0

  TextEdit
    id: serverPortTextEdit
    text: 7171
    anchors.right: parent.right
    anchors.left: parent.horizontalCenter
    anchors.top: parent.bottom
    visible: false
    height: 0

  QtCheckBox
    id: autoLoginBox
    enabled: false
    !text: tr('Auto login')
    !tooltip: tr('Open charlist automatically when starting client')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.bottom
    visible: false
    height: 0

  QtCheckBox
    id: httpLoginBox
    enabled: true
    !text: tr('Enable HTTP login')
    !tooltip: tr('If login fails using HTTPS (encrypted) try with HTTP (unencrypted)')
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.bottom
    visible: false
    height: 0

  QtButton
    id: btnCreateNewAccount
    !text: tr('Create New Account')
    anchors.left: parent.left
    anchors.top: parent.bottom
    size: 109 20
    visible: false
    height: 0
    @onClick: |
      self:disable()
      createWidgetAccount()

  Label
    id: serverInfoLabel
    font: verdana-11px-rounded
    anchors.top: parent.bottom
    anchors.left: parent.left
    color: green
    text-auto-resize: true
    visible: false
    height: 0
